{
  "name": "zero-swift",
  "version": "0.0.0",
  "private": true,
  "description": "Generates the Swift row types and schema of a Zero app for the Zero Swift client.",
  "license": "Apache-2.0",
  "bin": {
    "zero-swift": "./src/cli.ts"
  },
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "generate": "UPDATE_GENERATED=1 vitest run",
    "check-types": "tsc",
    "lint": "oxlint --quiet --config ../../oxlint.config.ts src/",
    "format": "oxfmt .",
    "check-format": "oxfmt --check ."
  },
  "dependencies": {
    "typescript": "6.0.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "oxfmt": "^0.65.0",
    "vitest": "^5.0.0",
    "zero-schema": "workspace:*",
    "zero-types": "workspace:*",
    "zql": "workspace:*"
  }
}
